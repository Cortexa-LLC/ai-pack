[Unit]
Description=AI-Pack Agent Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User={{USER}}
WorkingDirectory={{PROJECT_ROOT}}
ExecStart=/usr/local/bin/agent-server --server

# Environment variables
Environment="PATH=/usr/local/bin:/usr/bin:/bin"

# Restart policy
Restart=always
RestartSec=30
StartLimitInterval=300
StartLimitBurst=5

# Logging
StandardOutput=append:/tmp/agent-server.log
StandardError=append:/tmp/agent-server.log

# Security hardening
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
