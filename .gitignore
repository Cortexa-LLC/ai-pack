# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# Editor and IDE Files
.vscode/
.idea/
# .claude/ is session runtime data and stays out of git — EXCEPT workflows/, which
# holds the deterministic shepherd loop. Plugins cannot distribute workflows (see
# docs/SHEPHERDING.md), so .claude/workflows/ is the only place that file can live
# and still run, and it has to be version-controlled to be reviewable, shareable, and
# recoverable. Note the `.claude/*` form: git does not descend into an excluded
# DIRECTORY, so a plain `.claude/` would make the negation below unreachable.
.claude/*
!.claude/workflows/
*.swp
*.swo
*~
.project
.settings/
.classpath

# Exception: Allow templates/.claude/ (these are templates for consumer projects)
!templates/.claude/

# Temporary Files
*.tmp
*.bak
*.log
*.cache

# Project-specific (if testing integration)
/test-projects/
/scratch/

# Local workspace and context (not in repository)
.ai/
.ai-pack/

# Project-specific rule files (each project adds their own)
PROJECT-*.md
project-*.md
*-overrides.md
*-project.md

# Exception: Allow templates/*-overrides.md (these are templates for consumer projects)
!templates/*-overrides.md

