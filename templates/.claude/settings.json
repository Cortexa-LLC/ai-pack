      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run watch:*)",

      "Bash(gh repo view:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(jq:*)",
      "Bash(sleep:*)",
      "Bash(git add:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",
      "Bash(ls:*)",
