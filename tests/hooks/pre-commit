#!/bin/bash
#
# Git Pre-Commit Hook for ai-pack
#
# This hook runs pre-change validation before every commit.
# It ensures:
# - All tests pass
# - All roles have tests
# - Test structure is intact
#
# Installation:
#   cp tests/hooks/pre-commit .git/hooks/pre-commit
#   chmod +x .git/hooks/pre-commit
#
# Bypass (NOT recommended):
#   git commit --no-verify
#
# Version: 1.0
# Date: 2026-01-15

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

echo ""
echo "======================================================================="
echo "Pre-Commit Validation"
echo "======================================================================="
echo ""

# Find repository root
REPO_ROOT=$(git rev-parse --show-toplevel)
if [ $? -ne 0 ]; then
    echo -e "${RED}❌ Error: Not in a git repository${NC}"
    exit 1
fi

# Change to tests directory
cd "$REPO_ROOT/tests" || {
    echo -e "${RED}❌ Error: tests/ directory not found${NC}"
    exit 1
}

# Check if validator exists
if [ ! -f "pre-change-validation.py" ]; then
    echo -e "${RED}❌ Error: pre-change-validation.py not found${NC}"
    echo "Expected location: $REPO_ROOT/tests/pre-change-validation.py"
    exit 1
fi

# Run quick validation (skip slow integration tests for faster commits)
echo "Running validation (quick mode)..."
echo ""

python3 pre-change-validation.py --quick

VALIDATION_RESULT=$?

echo ""

# Check result
if [ $VALIDATION_RESULT -ne 0 ]; then
    echo ""
    echo -e "${RED}=======================================================================${NC}"
    echo -e "${RED}❌ Pre-Commit Validation FAILED${NC}"
    echo -e "${RED}=======================================================================${NC}"
    echo ""
    echo "Your commit has been blocked because validation failed."
    echo ""
    echo "Options:"
    echo "  1. Fix the errors above and try again (RECOMMENDED)"
    echo "  2. Run full validation: cd tests/ && python3 pre-change-validation.py"
    echo "  3. Bypass hook: git commit --no-verify (NOT RECOMMENDED)"
    echo ""
    exit 1
fi

echo ""
echo -e "${GREEN}=======================================================================${NC}"
echo -e "${GREEN}✅ Pre-Commit Validation PASSED${NC}"
echo -e "${GREEN}=======================================================================${NC}"
echo ""
echo "Proceeding with commit..."
echo ""

exit 0
