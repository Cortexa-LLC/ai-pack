{
  "server": {
    "host": "localhost",
    "port": 8080,
    "max_concurrent_agents": 10,
    "worker_pool_size": 10
  },
  "api": {
    "anthropic_model": "claude-sonnet-4-5-20250929",
    "max_tokens": 8000,
    "timeout_seconds": 600,
    "mode": "proxy",
    "proxy": {
      "base_url": "https://api.acme.com/anthropic/v1"
    }
  },
  "agent": {
    "max_inactive_turns": 10
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "metrics": {
    "enabled": true,
    "max_task_durations": 1000
  },
  "task_cleanup": {
    "enabled": true,
    "archive_after_days": 15
  }
}

