{
  "server": {
    "host": "localhost",
    "port": 8080,
    "max_concurrent_agents": 10,
    "worker_pool_size": 10
  },
  "api": {
    "anthropic_model": "claude-sonnet-4-5-20250929",
    "max_tokens": 32000,
    "timeout_seconds": 600,
    "mode": "direct"
  },
  "agent": {
    "max_inactive_turns": 10
  },
  "logging": {
    "level": "info",
    "format": "json"
  },
  "metrics": {
    "enabled": true,
    "max_task_durations": 1000
  }
}
